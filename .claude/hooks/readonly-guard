#!/usr/bin/env bash
# PreToolUse hook for read-only roles (explorer, verifier, reviewer).
# Blocks Bash commands that mutate the working tree, index, or branch state,
# and Write/Edit outside .superpowers/ (report files).
# Exit 2 = block; stderr is shown to the agent.
set -euo pipefail
input=$(cat)
tool=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tool_name",""))' 2>/dev/null || true)

# Write/Edit: only the role's own report files under .superpowers/ are allowed.
if [ "$tool" != "Bash" ]; then
  path=$(printf '%s' "$input" | python3 -c 'import json,sys; t=json.load(sys.stdin).get("tool_input",{}); print(t.get("file_path") or t.get("path") or "")' 2>/dev/null || true)
  case "$path" in
    */.superpowers/*|.superpowers/*) exit 0 ;;
    "") exit 0 ;;
    *) echo "readonly-guard: this role may only write reports under .superpowers/. Blocked: $path" >&2; exit 2 ;;
  esac
fi

cmd=$(printf '%s' "$input" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("tool_input",{}).get("command",""))' 2>/dev/null || true)
[ -z "$cmd" ] && exit 0

deny='(^|[;&|[:space:]])(rm|mv|cp|touch|tee|sed[[:space:]]+-i|perl[[:space:]]+-i|chmod|chown|truncate|dd)([[:space:]]|$)|(^|[^<>])>([^&]|$)|(^|[;&|[:space:]])git[[:space:]]+(add|commit|push|checkout|switch|reset|rebase|merge|stash|clean|restore|rm|mv|tag|branch[[:space:]]+-[dDm]|cherry-pick|am|apply)([[:space:]]|$)|(^|[;&|[:space:]])(npm|pnpm|yarn|pip|pip3|uv|cargo|go)[[:space:]]+(install|add|remove|uninstall|publish)|docker[[:space:]]+(compose[[:space:]]+)?(up|down|rm|build|push)'
# Allow explicit test/e2e scripts the verifier needs even though they mutate containers.
allow='^[[:space:]]*(\./)?(scripts/e2e\.sh|scripts/preflight\.sh|docker[[:space:]]+compose[[:space:]]+(up|down|logs|ps|exec)|make[[:space:]]+(test|e2e|lint))'

if echo "$cmd" | grep -Eq "$allow"; then exit 0; fi
if echo "$cmd" | grep -Eq "$deny"; then
  echo "readonly-guard: this role is read-only. Blocked: $cmd" >&2
  echo "Report the change you wanted as a finding instead of making it." >&2
  exit 2
fi
exit 0
